# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# make sure anything which is vendored is copied
!/vendor/**/*

# repo specific
.direnv/
/result*
docker/gnosis_vpn
docker/gnosis_vpn-ctl
docker/gnosis_vpn-root
docker/gnosis_vpn-worker
gnosisvpn-ctl.log.*
# ci test
gpg-ed25519.conf
gcp-sa-*.json
*.p12

# general log files
*.log

# VsCode settings
.vscode/*
gnosisvpn-private-key.asc
